# ===========================================================================
# FinDSL — .gitignore
#
# Bewusst NICHT ignoriert (= eingecheckt, da der dokumentierte Frischklon-
# Workflow `npm install && npm run build` sie ohne vorheriges
# `npm run langium:generate` voraussetzt):
#   - packages/core/src/language/generated/   (Langium: ast/grammar/module)
#   - packages/core/syntaxes/findsl.tmLanguage.json  (Langium TextMate-Ausgabe)
# Diese sind reproduzierbar (`npm run langium:generate`), aber Teil des
# eingecheckten Standes. Grammatik-Quelle bleibt das Duo (SPEC.md
# Anhang A / findsl.langium).
# ===========================================================================

# --- Abhängigkeiten ---
node_modules/

# --- Lokales Ausgabe-/Scratch-Verzeichnis (z. B. `docgen -o tmp/...`) ---
/tmp/

# --- TypeScript-Build (tsc -b, composite; je Paket rootDir=src outDir=out) ---
out/
*.tsbuildinfo
tsconfig.tsbuildinfo

# --- esbuild-Bundles & self-contained CLI / natives Binary ---
# apps/vscode/out (Extension-Bundle) deckt `out/` oben bereits ab.
packages/cli/dist/
packages/lsp/dist/
packages/web/dist/
packages/editor/dist/
packages/editor-react/dist/

# --- IntelliJ-Plugin (Gradle): Build-Output. Wrapper-JAR + gradlew bleiben
#     bewusst eingecheckt (kein globales Gradle nötig). ---
apps/intellij/.gradle/
apps/intellij/build/
apps/intellij/.intellijPlatform/
# Lazy-Download-Manifest (#244): zur CI-Zeit aus den Release-Binary-Hashes
# generiert (scripts/gen-binary-checksums.mjs) — nicht eingecheckt.
apps/intellij/src/main/resources/binaries/

# --- Generierte Audit-Doku (regenerierbar via `findsl docgen`) ---
# Konvention: examples/<Gesetz>/out/<slug>-doku.{md,html,pdf}.
# Die kuratierte <slug>-doku.kopf.md (Input) liegt AUSSERHALB out/.
examples/**/out/

# --- Verpackte VS-Code-Extension ---
*.vsix

# --- Test-Coverage ---
coverage/
.nyc_output/

# --- Secrets / lokale Umgebung ---
.env
.env.*
!.env.example

# --- Logs & npm-Artefakte ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tgz

# --- Editor / IDE (lokal) ---
.idea/
*.iml
# VS Code: lokale Einstellungen ignorieren, geteilte Konfiguration behalten
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
*~
*.swp
*.swo

# --- Betriebssystem ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# Heruntergeladenes JUnit-Console-Standalone (codegen:difftest, gepinnt+SHA-verifiziert)
scripts/lib/

# Java-Runtime einbettung (regeneriert via scripts/embed-runtime-java.mjs)
packages/core/src/codegen/emit-java/runtime-files.generated.ts

# mermaid-Bundle für PAP-HTML (regeneriert via scripts/gen-mermaid-asset.mjs)
packages/core/src/papgen/mermaid-asset.generated.ts

# TS-Runtime einbettung (regeneriert via scripts/embed-runtime-ts.mjs)
packages/core/src/codegen/emit-ts/runtime-files-ts.generated.ts

# TS-Codegen-Gate: repo-interne Temp-Verzeichnisse (werden im finally
# aufgeräumt; Eintrag schützt vor Resten nach hartem Abbruch)
.ts-gate-*/

# Lokaler Dogfooding-Symlink auf das ausgelieferte Agent Skill (-> skills/findsl-author)
/.claude/skills/
