{
  "name": "findsl",
  "displayName": "FinDSL",
  "description": "Domänenspezifische Sprache für die deutsche steuerliche Finanzverwaltung",
  "version": "1.0.0-rc.6",
  "publisher": "findsl",
  "license": "EUPL-1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/findsl/findsl.git",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20.10.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension/main.cjs",
  "contributes": {
    "languages": [
      {
        "id": "findsl",
        "aliases": [
          "FinDSL",
          "findsl"
        ],
        "extensions": [
          ".findsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "findsl",
        "scopeName": "source.findsl",
        "path": "./syntaxes/findsl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "findsl",
        "path": "./snippets/findsl.code-snippets"
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "*.internal": {
            "fontStyle": "italic"
          }
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:findsl"
  ],
  "scripts": {
    "vscode:prepublish": "cd ../.. && npm run langium:generate && npm run build && npm run bundle"
  },
  "dependencies": {
    "@findsl/core": "1.0.0-rc.6",
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0"
  }
}
