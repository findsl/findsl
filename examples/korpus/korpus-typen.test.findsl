--
# Akzeptanztests — Simple-Typen

`prüfe`-Blöcke zu `korpus-typen.findsl`. Verifiziert, dass die in der
Foundation deklarierten Konstanten, Datensätze und Aufzählungen
syntaktisch akzeptiert werden und die erwarteten Werte tragen.
--

verwende {
    BEISPIEL_GANZZAHL,
    BEISPIEL_DEZIMAL,
    BEISPIEL_EURO,
    BEISPIEL_EUROCENT,
    BEISPIEL_CENT,
    BEISPIEL_PROZENT,
    BEISPIEL_WAHR,
    BEISPIEL_TEXT,
    BEISPIEL_LISTE,
    BEISPIEL_BEREICH,
    BEISPIEL_BEREICH_EXKLUSIV,
    BEISPIEL_BEREICH_SCHRITT,
    Rot,
    Grün,
    Blau,
    Aktiv,
    Punkt,
    Person,
} aus "./korpus-typen"

prüfe "§ 2.7 Literale — Konstanten-Identität" {
    testfall "Ganzzahl-Konstante mit Tausenderpunkten" {
        BEISPIEL_GANZZAHL == 1.000
    }
    testfall "Dezimal-Konstante mit Komma" {
        BEISPIEL_DEZIMAL == 3,14
    }
    testfall "Euro-Konstante" {
        BEISPIEL_EURO == 100
    }
    testfall "EuroCent-Konstante (2 Nachkommastellen)" {
        BEISPIEL_EUROCENT == 12,34
    }
    testfall "Cent-Konstante (Cast nötig: 50 ohne Kontext ist Ganzzahl)" {
        BEISPIEL_CENT == (50 als Cent)
    }
    testfall "Prozent-Konstante" {
        BEISPIEL_PROZENT == 19%
    }
    testfall "Wahrheitswert-Konstante" {
        BEISPIEL_WAHR
    }
    testfall "Text-Konstante" {
        BEISPIEL_TEXT == "Hallo, FinDSL!"
    }
}

prüfe "§ 3.7 Aufzählung — Wert-Identität" {
    testfall "Farbe-Werte sind paarweise verschieden" {
        Rot != Grün und Grün != Blau und Rot != Blau
    }
    testfall "Aufzählung Status — Aktiv ist gleich sich selbst" {
        Aktiv == Aktiv
    }
}

prüfe "§ 3.8 Datensatz — Konstruktor und Feldzugriff" {
    testfall "Punkt mit positiven Koordinaten" {
        var p: Punkt = Punkt(x = 3, y = 4)
        p.x == 3 und p.y == 4
    }
    testfall "Person mit Default-Alter (18) + Default-email (nichts)" {
        var p: Person = Person(name = "Anna")
        p.name == "Anna" und p.alter == 18 und p.email ist nichts
    }
    testfall "Person mit explizitem Alter und E-Mail" {
        var p: Person = Person(
            name  = "Bertha",
            alter = 42,
            email = "bertha@example.de",
        )
        p.name == "Bertha" und p.alter == 42
    }
}

prüfe "§ 4.15 Listen-Literal" {
    testfall "BEISPIEL_LISTE hat 3 Elemente" {
        BEISPIEL_LISTE.länge == 3
    }
    testfall "BEISPIEL_LISTE enthält 2" {
        BEISPIEL_LISTE.enthält(2)
    }
}

prüfe "§ 4.16 Bereich-Literale" {
    testfall "1 bis 10 hat 10 Elemente" {
        BEISPIEL_BEREICH.länge == 10
    }
    testfall "0 bis unter 10 hat 10 Elemente (exklusiv)" {
        BEISPIEL_BEREICH_EXKLUSIV.länge == 10
    }
    testfall "0 bis 20 schritt 5 hat 5 Elemente" {
        BEISPIEL_BEREICH_SCHRITT.länge == 5
    }
}
