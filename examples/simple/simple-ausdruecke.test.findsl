--
# Akzeptanztests — Simple-Ausdrücke

`prüfe`-Blöcke zu `simple-ausdruecke.findsl`. Jeder SPEC § 4-Ausdruck
hat mindestens einen `testfall`. Enthält außerdem den **`erwartet
abbruch`**-Fall (§ 10.2 + § 4.19), der den Generat-Pfad für
`FinDslAbbruch` triggert.
--

verwende {
    Addition,
    Subtraktion,
    MultiplikationEuroProzent,
    Division,
    IstGleich,
    IstUngleich,
    IstKleiner,
    IstKleinerGleich,
    IstGroesser,
    IstGroesserGleich,
    LogischUnd,
    LogischNicht,
    AmpelGuard,
    AufrufPositional,
    AufrufBenannt,
    PunktX,
    PunktVon,
    DreiZahlen,
    BlockMitVar,
    KehrwertOderAbbruch,
} aus "./simple-ausdruecke"

prüfe "§ 4.2 Arithmetik" {
    testfall "Addition 1 € + 2 € = 3 €" {
        Addition(1, 2) == 3
    }
    testfall "Subtraktion 10 - 3 = 7" {
        Subtraktion(10, 3) == 7
    }
    testfall "100 € × 19% = 19,00 € (Euro × Prozent → EuroCent)" {
        MultiplikationEuroProzent(100, 19%) == 19,00
    }
    testfall "Division 10,0 / 4,0 = 2,5" {
        Division(10,0, 4,0) == 2,5
    }
}

prüfe "§ 4.3 Vergleichsoperatoren" {
    testfall "== identisch" { IstGleich(5, 5) }
    testfall "== verschieden ist falsch" { nicht IstGleich(5, 6) }
    testfall "!= verschieden" { IstUngleich(5, 6) }
    testfall "< echt kleiner" { IstKleiner(3, 5) }
    testfall "<= gleich gilt" { IstKleinerGleich(5, 5) }
    testfall "> echt größer" { IstGroesser(7, 5) }
    testfall ">= gleich gilt" { IstGroesserGleich(5, 5) }
}

prüfe "§ 4.4 Logische Operatoren" {
    testfall "und: wahr und wahr = wahr" { LogischUnd(wahr, wahr) }
    testfall "und: wahr und falsch = falsch" { nicht LogischUnd(wahr, falsch) }
    testfall "nicht: nicht falsch = wahr" { LogischNicht(falsch) }
}

// § 4.5 Elvis und § 4.6 Sicher-Zugriff: ausgespart bis Codegen-Lücken
// geschlossen sind (Issue #44 — NullLiteral + Elvis-`oder` out-of-scope).

// § 4.7 Force-Unwrap (`!!`): ausgespart, siehe TODO(#44) in simple-ausdruecke.findsl.

// § 4.8 Cast `als`: ausgespart, siehe TODO(#44) in simple-ausdruecke.findsl.

// § 4.9 `wenn`-Ausdruck: ausgespart, siehe TODO(#44) in simple-ausdruecke.findsl.

prüfe "§ 4.10.1 Wähle (Guards, ohne Subjekt)" {
    testfall "20 km/h → Score 1 (langsam)" { AmpelGuard(20)  == 1 }
    testfall "45 km/h → Score 2 (normal)"  { AmpelGuard(45)  == 2 }
    testfall "80 km/h → Score 3 (schnell)" { AmpelGuard(80)  == 3 }
    testfall "200 km/h → Score 4 (rasant)" { AmpelGuard(200) == 4 }
}

// TODO(#44): § 4.10.2 `wähle (subjekt)` mit Cross-Modul-Enum-Werten
// (Rot/Grün/Blau aus simple-typen) wird im Test-Codegen kaputt
// generiert — `Blau` ist ohne `SimpleTypen.`-Präfix im generierten
// Test-Code unbekannt. Test-Aussparung bis Codegen-Lücke geschlossen:
//
//   testfall "Subjekt: Rot → 1 (warm)"  { FarbBeschreibung(Rot)  == 1 }
//   testfall "Subjekt: Grün → 2 (kühl)" { FarbBeschreibung(Grün) == 2 }
//   testfall "Subjekt: Blau → 2 (kühl)" { FarbBeschreibung(Blau) == 2 }

prüfe "§ 4.11 Funktionsaufruf" {
    testfall "positional: 5 × 3 = 15" { AufrufPositional() == 15 }
    testfall "benannt mit Default: 5 × 10 = 50" { AufrufBenannt() == 50 }
}

// § 4.12 Lambda: vollständig ausgespart, siehe TODO(#44).

prüfe "§ 4.13 + 4.14 Feldzugriff & Datensatz-Konstruktor" {
    testfall "Feldzugriff x" { PunktX(PunktVon(3, 4)) == 3 }
    testfall "Konstruierter Punkt hat erwartetes y" { PunktVon(3, 4).y == 4 }
}

prüfe "§ 4.15 Listen-Konstruktor" {
    testfall "Liste [1,2,3] hat Länge 3" { DreiZahlen().länge == 3 }
}
// § 4.16 Bereich-Konstruktor: ausgespart bis Codegen-Lücken
// geschlossen sind (Issue #44 — `Range` out-of-scope).

prüfe "§ 4.17 Block-Ausdruck mit var" {
    testfall "(2+3) × 2 = 10" { BlockMitVar(2, 3) == 10 }
}

prüfe "§ 4.19 Abbruch-Ausdruck" {
    testfall "Kehrwert von 2,0 = 0,5" {
        KehrwertOderAbbruch(2,0) == 0,5
    }
    testfall "Kehrwert von 0 bricht ab (Typ never)" erwartet abbruch {
        KehrwertOderAbbruch(0,0)
    }
}
