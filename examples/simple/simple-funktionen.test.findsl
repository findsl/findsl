--
# Akzeptanztests — Simple-Funktionen

`prüfe`-Blöcke zu `simple-funktionen.findsl`. Verifiziert jede
SPEC § 6.2-Funktionsform.
--

verwende {
    BlockBody,
    ExpressionBody,
    Bruttopreis,
    MachAddierer,
    ZweiSchritteFest,
    ZweiPlusEins,
    FesterEuroBetrag,
    DreiDezimalwerte,
    VerschiebePunkt,
} aus "./simple-funktionen"

verwende { Punkt } aus "./simple-typen"

prüfe "§ 6.2.1 Block-Body" {
    testfall "BlockBody(2,3) = (2+3) + (2*3) = 11" {
        BlockBody(2, 3) == 11
    }
}

prüfe "§ 6.2.2 Expression-Body" {
    testfall "ExpressionBody(10,5) = 15" {
        ExpressionBody(10, 5) == 15
    }
}

prüfe "§ 6.2.3 Default-Parameter" {
    testfall "Bruttopreis(100): Default 19% → 119 €" {
        Bruttopreis(100) == 119
    }
    testfall "Bruttopreis(100, 7%): MwSt überschrieben → 107 €" {
        Bruttopreis(100, 7%) == 107
    }
}

prüfe "§ 6.2.4 Closures (Funktionstyp als Rückgabe)" {
    testfall "MachAddierer(5) ergibt eine Closure, die +5 rechnet" {
        var plus5: (Ganzzahl) -> Ganzzahl = MachAddierer(5)
        plus5(10) == 15
    }
    testfall "ZweiSchritteFest(7, 0) = 14" {
        ZweiSchritteFest(7, 0) == 14
    }
}

prüfe "§ 8.4 Sichtbarkeit (`_`-Präfix)" {
    testfall "ZweiPlusEins(10) ruft intern _AddiereEins zweimal auf" {
        ZweiPlusEins(10) == 12
    }
}

prüfe "§ 3.13 Bidirektionale Inferenz" {
    testfall "FesterEuroBetrag() liefert Euro-Wert 100" {
        FesterEuroBetrag() == 100
    }
    testfall "DreiDezimalwerte() liefert Liste<Dezimal> der Länge 3" {
        DreiDezimalwerte().länge == 3
    }
}

prüfe "Orchestrierung — VerschiebePunkt" {
    testfall "(3,4) + (10,20) = (13,24)" {
        var v: Punkt = VerschiebePunkt(Punkt(x = 3, y = 4), 10, 20)
        v.x == 13 und v.y == 24
    }
}
