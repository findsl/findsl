
fn AbrundenEuro(betrag: EuroCent): Euro = betrag.abrunden()

fn AufrundenEuro(betrag: EuroCent): Euro = betrag.aufrunden()

fn AbrundenProzent(p: Prozent): Prozent = p.abrunden()

fn AufrundenProzent(p: Prozent): Prozent = p.aufrunden()

fn AbrundenDezimal(d: Dezimal): Ganzzahl = d.abrunden()

fn AufrundenDezimal(d: Dezimal): Ganzzahl = d.aufrunden()



prüfe "Prüfe mathematische Funktionen: abrunden / aufrunden" {
    testfall "Abrunden Euro" {
         AbrundenEuro(12,34) == 12
    }
    testfall "Aufrunden Euro" {
         AufrundenEuro(12,34) == 13
    }
    testfall "Abrunden Prozent" {
         AbrundenProzent(12,34) == 12
    }
    testfall "Aufrunden Prozent" {
         AufrundenProzent(12,34) == 13
    }
    testfall "Abrunden Dezimal" {
         AbrundenDezimal(12,34) == 12
    }
    testfall "Aufrunden Dezimal" {
         AufrundenDezimal(12,34) == 13
    }
}