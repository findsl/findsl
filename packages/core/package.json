{
  "name": "@findsl/core",
  "version": "1.1.0",
  "description": "FinDSL Sprachkern: Grammatik/AST/Validator/Typen, Interpreter, Doku-Generator, Codegen",
  "type": "module",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/findsl/findsl.git",
    "directory": "packages/core"
  },
  "exports": {
    "./*.js": {
      "source": "./src/*.ts",
      "types": "./out/*.d.ts",
      "default": "./out/*.js"
    }
  },
  "files": [
    "out"
  ],
  "scripts": {
    "langium:generate": "langium generate && node ../../scripts/enhance-textmate.mjs",
    "prepack": "test -d out || npm --prefix ../.. run build"
  },
  "dependencies": {
    "chevrotain": "12.0.0",
    "decimal.js": "10.6.0",
    "katex": "0.17.0",
    "langium": "4.2.4",
    "markdown-it": "14.2.0",
    "mathjax-full": "3.2.2",
    "pdfmake": "0.3.9",
    "vscode-languageserver": "9.0.1"
  },
  "devDependencies": {
    "langium-cli": "4.2.1"
  }
}
